{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**"
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images used by the e2e harness",
      "managerFilePatterns": [
        "/^test/e2e/run\\.sh$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "IMAGE=\\$\\{IMAGE:-(?<depName>alpine):(?<currentValue>[^}]+)\\}",
        "'(?<depName>alpine):(?<currentValue>\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "golangci-lint pinned in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION \\?= (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "govulncheck pinned in the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GOVULNCHECK_VERSION \\?= (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ]
}
