# Maintainer: Itxaka Garcia <itxaka.garcia@spectrocloud.com>
pkgname=sysext
pkgver=0.2.0
pkgrel=0
pkgdesc="Reimplementation of systemd-sysext and systemd-confext for OpenRC systems"
url="https://github.com/Itxaka/sysext-alpine"
arch="all"
license="MIT"
makedepends="go>=1.26"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::https://github.com/Itxaka/sysext-alpine/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/sysext-alpine-$pkgver"
options="net" # go modules are downloaded during the build

export GOTOOLCHAIN=local
export GOFLAGS="$GOFLAGS -trimpath -mod=readonly -modcacherw"
export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	CGO_ENABLED=0 go build \
		-ldflags "-X main.version=$pkgver" \
		-o bin/sysext ./cmd/sysext
}

check() {
	CGO_ENABLED=0 go test ./...
}

package() {
	install -Dm755 bin/sysext "$pkgdir"/usr/bin/sysext
	ln -s sysext "$pkgdir"/usr/bin/confext

	install -Dm755 packaging/openrc/sysext.initd "$pkgdir"/etc/init.d/sysext
	install -Dm755 packaging/openrc/confext.initd "$pkgdir"/etc/init.d/confext
	install -Dm644 packaging/openrc/sysext.confd "$pkgdir"/etc/conf.d/sysext
	install -Dm644 packaging/openrc/confext.confd "$pkgdir"/etc/conf.d/confext

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

# sha512sums are added by "abuild checksum" once the v$pkgver tag is
# published (see README.md).
