#!/sbin/openrc-run
# shellcheck shell=busybox disable=SC2034
# Counterpart of systemd-sysext.service. Extensions are merged in the boot
# runlevel, before the services that may use them; the kernel command line
# option systemd.sysext=0 makes sysext skip the merge when started from here.

description="Merge system extension images into /usr/ and /opt/"
extra_started_commands="reload"
description_reload="Refresh the merged system extensions"

command="/usr/bin/sysext"
command_args="${SYSEXT_OPTS}"

depend() {
	need localmount
	after modules
	before bootmisc opentmpfiles-setup sysctl hostname networking
}

# The ConditionCapability=CAP_SYS_ADMIN of the systemd unit: in containers
# without it there is nothing to do.
privileged() {
	local cap
	cap=$(sed -n 's/^CapEff:[[:space:]]*//p' /proc/self/status)
	[ $(( (0x${cap:-0} >> 21) & 1 )) -eq 1 ] && return 0
	einfo "No CAP_SYS_ADMIN, skipping"
	return 1
}

start() {
	privileged || return 0
	ebegin "Merging system extensions"
	$command $command_args refresh
	eend $?
}

reload() {
	privileged || return 0
	ebegin "Refreshing system extensions"
	$command $command_args refresh
	eend $?
}

stop() {
	privileged || return 0
	# Nothing is to be restarted while the system goes down.
	local noreload=
	yesno "$RC_GOINGDOWN" && noreload=--no-reload
	ebegin "Unmerging system extensions"
	$command $command_args $noreload unmerge
	eend $?
}
